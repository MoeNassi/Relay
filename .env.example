# Relay configuration template. Copy to .env and fill in real values.
# Register the app at https://entra.microsoft.com -> App registrations.

RELAY_SSO_TENANT_ID=
RELAY_SSO_CLIENT_ID=
RELAY_SSO_CLIENT_SECRET=
RELAY_SSO_REDIRECT_URI=http://localhost:5173/auth/callback
RELAY_SSO_ALLOWED_DOMAIN=um6p.ma
RELAY_SSO_SECURE=0

# --- VMProv auto-provision worker (optional) ---
# When an environment reaches the `vms` stage, Relay submits a VM batch to the
# UM6P VMProv agent, then advances that env (default -> `gitlab`) once VMProv's
# completion callback reports the job Completed. VMProv is asynchronous: the
# submit returns 202 "accepted", and completion arrives later on the callback.
# The worker is OFF unless URL + TOKEN + CALLBACK_URL are all set.
RELAY_VM_AGENT_URL=https://vmprov.um6p.ma/api/agent/jobs  # VMProv submit endpoint
# VMProv serves a self-signed cert — Node's fetch refuses it unless the cert is
# trusted. Export the cert once and point Node at it (do NOT use
# NODE_TLS_REJECT_UNAUTHORIZED=0; that disables TLS checks process-wide):
#   openssl s_client -connect vmprov.um6p.ma:443 </dev/null 2>/dev/null \
#     | openssl x509 > server/data/vmprov-ca.pem
NODE_EXTRA_CA_CERTS=server/data/vmprov-ca.pem
RELAY_VM_AGENT_TOKEN=          # VMProv Bearer token (portal -> Application Agent tokens)
RELAY_VM_CALLBACK_URL=         # where VMProv POSTs completion; must be a *.um6p.ma HTTPS URL, e.g. https://relay.um6p.ma/vmprov/callback
RELAY_VM_CALLBACK_TOKEN=       # shared secret; sent as callback_auth_token and verified on the inbound callback
RELAY_VM_SITE=                 # default vm_site when a VM has none: RABAT | BG | BGOLD | F2 | NRO1
RELAY_VM_REQUESTER=           # requester email on every VM (default: IT-PRODUCTIONAPP@um6p.ma)
RELAY_VM_SUBMITTER=relay       # free-text label echoed in VMProv audit trails
RELAY_VM_NEXT_STAGE=gitlab     # stage to advance to when the job completes
RELAY_VM_TIMEOUT_MS=30000      # per-request timeout (aborts a hung submit/reconcile)
RELAY_VM_MAX_CONCURRENT=4      # max simultaneous VMProv requests in flight
RELAY_VM_RETRY_MS=60000        # backoff before resubmitting an errored env
RELAY_VM_RECONCILE_MS=300000   # recheck a stuck 'submitted' job via GET (missed-callback safety net)
